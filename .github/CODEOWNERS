/assets/fedposter.css       @fedpromptly
/assets/fedposter.js        @fedpromptly

# Landing page — primary entry point & SEO surface
/index.html                 @fedpromptly

# Dashboard — the heart of the product (composition + multi-post)
# NOTE: dashboard.html / assets/dashboard.* are referenced; if files are
# named differently, update these patterns to match.
/assets/dashboard.js        @fedpromptly
/assets/dashboard.css       @fedpromptly

# Per-page feature modules
